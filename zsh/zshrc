# ~/.zshrc — symlinked from dotfiles/zsh/zshrc.
# Portable across macOS and Ubuntu. NOTHING SECRET GOES IN THIS FILE:
# machine-local values live in ~/.zshrc.local (gitignored), sourced at the end.

# ---------------------------------------------------------------- environment
export EDITOR="${EDITOR:-vim}"
export PAGER="${PAGER:-less}"
export LESS="-FRX"
export LANG="${LANG:-en_US.UTF-8}"

# Homebrew (Apple Silicon, Intel) — harmless when absent.
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
[ -x /usr/local/bin/brew ]    && eval "$(/usr/local/bin/brew shellenv)"

# Personal bins, first on PATH. `path` is deduped by zsh.
typeset -U path
path=("$HOME/dotfiles/bin" "$HOME/.local/bin" $path)
export PATH

# -------------------------------------------------------------------- history
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY          # one history across panes/sessions
setopt HIST_IGNORE_ALL_DUPS   # keep only the most recent copy of a command
setopt HIST_IGNORE_SPACE      # a leading space keeps it out of history
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY            # expand !! before running it
setopt EXTENDED_HISTORY

# ---------------------------------------------------------------- shell feel
setopt AUTO_CD                # `foo` = `cd foo`
setopt INTERACTIVE_COMMENTS   # allow # comments when typing
setopt NO_BEEP
setopt PROMPT_SUBST

# ------------------------------------------------------------------ completion
autoload -Uz compinit
# Rebuild the dump at most once a day; otherwise reuse it (faster startup).
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive
zstyle ':completion:*' list-colors ''

# History search on the arrow keys, scoped to what you've typed.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^R'   history-incremental-search-backward

# --------------------------------------------------------------------- aliases
alias ll='ls -lh'
alias la='ls -lAh'
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --graph --decorate -20'
alias gco='git checkout'
alias gp='git push'
alias serve='python3 -m http.server'
alias path='echo $PATH | tr ":" "\n"'

# Better tools when installed, same muscle memory when not.
command -v eza    >/dev/null && { alias ls='eza --group-directories-first'; alias ll='eza -l --git'; alias la='eza -la --git'; alias tree='eza --tree'; }
command -v bat    >/dev/null && alias cat='bat --paging=never'
command -v batcat >/dev/null && alias cat='batcat --paging=never'   # Ubuntu's name for bat
command -v fdfind >/dev/null && alias fd='fdfind'                   # Ubuntu's name for fd
command -v rg     >/dev/null && alias grep='rg'

# snaxbox — home server + dev box. `sb` from anywhere (LAN or Tailscale).
alias sb='ssh kaushal@192.168.1.228'
alias sbh='herdr --remote kaushal@192.168.1.228'   # attach a Herdr session there

# ------------------------------------------------------------------- functions
# mkdir + cd
mkcd() { mkdir -p "$1" && cd "$1"; }

# Fuzzy-find a file and open it in $EDITOR.
fe() { local f; f=$(fzf --height 40% --reverse) && [ -n "$f" ] && $EDITOR "$f"; }

# Git worktree helpers — herdr leans on worktrees, so make them one word.
wt()  { git worktree list; }
wtn() { git worktree add "../$(basename "$PWD")-$1" -b "$1"; }   # wtn <branch>

# ---------------------------------------------------------------- integrations
command -v zoxide   >/dev/null && eval "$(zoxide init zsh)"        # z <dir>
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v herdr    >/dev/null && eval "$(herdr completion zsh 2>/dev/null)"
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh

# A plain, fast prompt when starship isn't installed: dir + git branch.
if ! command -v starship >/dev/null; then
  autoload -Uz vcs_info
  zstyle ':vcs_info:git:*' formats ' %F{242}(%b)%f'
  precmd() { vcs_info }
  PROMPT='%F{blue}%~%f${vcs_info_msg_0_} %# '
fi

# ------------------------------------------------------------------ local only
# Secrets, work paths, per-machine tweaks. Not in git. See zshrc.local.example.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
