#!/usr/bin/env bash
# devday — what today looks like: Claude spend, repo state, and the commute.
#
#   devday            # the greeting
#   devday --refresh  # force-refresh the cached token usage
#
# Everything is best-effort: any section that can't answer is simply omitted,
# so this stays fast and never blocks a shell.
set -uo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/devday"
USAGE_CACHE="$CACHE_DIR/usage.txt"
USAGE_TTL=900                                    # 15 minutes
SNAXBOX="${SNAXBOX_HOST:-kaushal@192.168.1.228}" # bridge host for the commute
mkdir -p "$CACHE_DIR"

dim()  { printf '\033[2m%s\033[0m' "$*"; }
bold() { printf '\033[1m%s\033[0m' "$*"; }
gold() { printf '\033[38;5;215m%s\033[0m' "$*"; }

# ------------------------------------------------------------------- greeting
hour=$(date +%-H)
if   [ "$hour" -lt 12 ]; then part="morning"
elif [ "$hour" -lt 18 ]; then part="afternoon"
else                          part="evening"; fi
printf '\n ☀  %s — good %s\n\n' "$(bold "$(date '+%A, %b %-d')")" "$part"

# --------------------------------------------------------- claude token usage
# ccusage reads Claude Code's local logs (~/.claude/projects). Cache the answer:
# the npx path is slow, and a greeting must not wait on it.
usage_fresh() {
  [ -f "$USAGE_CACHE" ] || return 1
  local age now mtime
  now=$(date +%s)
  mtime=$(stat -f %m "$USAGE_CACHE" 2>/dev/null || stat -c %Y "$USAGE_CACHE" 2>/dev/null || echo 0)
  age=$(( now - mtime ))
  [ "$age" -lt "$USAGE_TTL" ]
}

refresh_usage() {
  local runner
  if command -v ccusage >/dev/null; then runner="ccusage"
  elif command -v npx >/dev/null;     then runner="npx -y ccusage@latest"
  else return 1; fi
  $runner daily --json 2>/dev/null | python3 -c '
import sys, json, datetime
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
rows = d.get("daily") or d.get("data") or []
if not rows: sys.exit(1)
today = datetime.date.today().strftime("%Y-%m-%d")
row = next((r for r in rows if str(r.get("date","")).endswith(today[5:])), rows[-1])
tok  = row.get("totalTokens") or 0
cost = row.get("totalCost") or 0.0
models = ", ".join(sorted({m.split("-2")[0] for m in (row.get("modelsUsed") or [])})) or ""
print(f"{tok}\t{cost:.2f}\t{models}")
' > "$USAGE_CACHE.tmp" 2>/dev/null && mv "$USAGE_CACHE.tmp" "$USAGE_CACHE"
}

if [ "${1:-}" = "--refresh" ] || ! usage_fresh; then
  refresh_usage || true
fi

if [ -s "$USAGE_CACHE" ]; then
  IFS=$'\t' read -r tok cost models < "$USAGE_CACHE"
  human=$(python3 - "$tok" <<'PY'
import sys
n = int(sys.argv[1])
for unit, size in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
    if n >= size:
        print(f"{n/size:.1f}{unit}"); break
else:
    print(str(n))
PY
)
  printf ' 🪙  %-14s %s tokens · %s%s\n' "Claude today" "$(gold "$human")" "$(gold "\$$cost")" \
    "$([ -n "$models" ] && printf ' %s' "$(dim "· $models")")"
fi

# ------------------------------------------------------------------ repo state
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  repo=$(basename "$(git rev-parse --show-toplevel)")
  branch=$(git rev-parse --abbrev-ref HEAD)
  dirty=$(git status --porcelain | wc -l | tr -d ' ')
  today_commits=$(git log --since=midnight --oneline 2>/dev/null | wc -l | tr -d ' ')
  printf ' 📝  %-14s %s %s%s\n' "$repo" "$branch" \
    "$([ "$dirty" -gt 0 ] && printf '✚%s ' "$dirty")" \
    "$(dim "· $today_commits commit(s) today")"

  trees=$(git worktree list 2>/dev/null | tail -n +2 | awk '{print $1}' | xargs -n1 basename 2>/dev/null | paste -sd', ' -)
  [ -n "$trees" ] && printf ' 🌳  %-14s %s\n' "worktrees" "$(dim "$trees")"
fi

# -------------------------------------------------------------------- upkeep
# Home maintenance from the Snaxpad bridge — only speaks up when something is
# overdue/due (or coming up), so it stays quiet when the house is on track.
maint=$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$SNAXBOX" \
        'curl -s --max-time 6 localhost:8788/maintenance' 2>/dev/null)
if [ -n "$maint" ]; then
  printf '%s' "$maint" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
s = d.get("summary", {})
labels = s.get("attention_labels", [])
if not labels:
    sys.exit(0)
urgent = s.get("overdue", 0) + s.get("due", 0)
tag = ("%d due" % urgent) if urgent else ("%d coming up" % s.get("plan", 0))
shown = ", ".join(labels[:3]) + ("…" if len(labels) > 3 else "")
print(" \U0001F527  %-13s %s · %s" % ("Upkeep", tag, shown))
' 2>/dev/null
fi

# -------------------------------------------------------------------- commute
# Live door-to-door plan from the Snaxpad bridge. Short timeout; skipped when
# the box isn't reachable (off the LAN/tailnet).
plan=$(ssh -o BatchMode=yes -o ConnectTimeout=3 "$SNAXBOX" \
        'curl -s --max-time 6 localhost:8788/trains/plan' 2>/dev/null)
if [ -n "$plan" ]; then
  printf '%s' "$plan" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for dest in d.get("destinations", []):
    opts = dest.get("options") or []
    if not opts: continue
    o = opts[0]
    lm = o.get("leave_in_min", 0)
    leave = "now" if lm <= 0 else str(lm) + " min"
    print(" \U0001F687  → %-11s %s min · leave %s · %s"
          % (dest.get("label", "?"), o.get("total_min", "?"), leave, o.get("label", "")))
' 2>/dev/null
fi

echo
